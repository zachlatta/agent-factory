#!/bin/sh
# Land HEAD on main: fetch, rebase, secret scan, vet and test, push HEAD:main. Retries a rejected
# push (other agents push main too). Never pass --no-verify: the pre-push hook scans again.
# An agent (PASEO_AGENT_ID set) also needs the factory's landing review to approve exactly the
# rebased HEAD before the push; a review that does not approve, or cannot run, stops without pushing,
# and only a push that main moved under is retried. Each try pins the fetched main as its base:
# origin/main is shared by every worktree, so another one may move it at any time. An agent's run first
# records its PID and start time on its agent (factory.land-run), or stops: the factory reads the agent's
# idle turn as a landing still under way only while that exact process runs.
set -eu
root=$(git rev-parse --show-toplevel)
cd "$root"
bin="${FACTORY_BIN:-$HOME/.local/share/agent-factory/factory}"
if [ -n "$(git status --porcelain)" ]; then
	echo "land: uncommitted changes; commit or drop them first" >&2
	exit 1
fi
if [ -n "${PASEO_AGENT_ID:-}" ]; then
	# Record this run (PID and start time) on the agent before any long step, so the factory reads
	# the agent's idle turn as a landing still under way only while this exact process lives.
	started=$(LC_ALL=C TZ=UTC ps -o lstart= -p $$ | tr -s ' :' '__' | sed 's/^_//;s/_$//')
	case "$started" in
	'' | *[!A-Za-z0-9_]*) started= ;;
	esac
	if [ -z "$started" ] || ! paseo agent update "$PASEO_AGENT_ID" --label "factory.land-run=$$.$started" >/dev/null; then
		echo "land: could not record this landing run with the factory; not landing" >&2
		exit 1
	fi
fi
for try in 1 2 3 4 5; do
	git fetch -q origin main
	base=$(git rev-parse --verify FETCH_HEAD^{commit})
	git rebase -q "$base"
	if [ -z "$(git rev-list "$base..HEAD")" ]; then
		echo "land: nothing to land"
		exit 0
	fi
	bin/scan "$base..HEAD"
	go vet ./...
	go test ./...
	if [ -n "${PASEO_AGENT_ID:-}" ]; then
		head=$(git rev-parse HEAD)
		if [ ! -x "$bin" ] || ! grep -aq 'api/land-review' "$bin"; then
			echo "land: $bin has no land-review command, so HEAD cannot be reviewed; not pushing" >&2
			exit 1
		fi
		if ! "$bin" land-review -why "bin/land: the rebased candidate $head, exactly as it will be pushed" >&2; then
			echo "land: the landing review did not approve $head; not pushing" >&2
			exit 1
		fi
		if [ "$(git rev-parse HEAD)" != "$head" ] || [ -n "$(git status --porcelain)" ]; then
			echo "land: the checkout changed during the landing review; not pushing" >&2
			exit 1
		fi
	fi
	if git push -q origin HEAD:main; then
		echo "land: pushed $(git rev-parse --short HEAD) to main"
		exit 0
	fi
	if [ -n "${PASEO_AGENT_ID:-}" ]; then
		git fetch -q origin main
		if [ "$(git rev-parse --verify FETCH_HEAD^{commit})" = "$base" ]; then
			echo "land: push failed and main did not move (a scan or review refused it); not retrying" >&2
			exit 1
		fi
	fi
	echo "land: push rejected (try $try), retrying" >&2
	sleep $((try * 3))
done
echo "land: gave up after 5 tries" >&2
exit 1
